  "panels": [
    {"id":1,"type":"stat","title":"Agent Run 成功率","gridPos":{"h":4,"w":6,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"orange","value":0.7},{"color":"green","value":0.85}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"expr":"sum(rate(mewcode_agent_run_total{outcome=\"success\"}[5m]))/clamp_min(sum(rate(mewcode_agent_run_total[5m])),0.001)","legendFormat":"success"}]},
    {"id":2,"type":"stat","title":"请求成功率","gridPos":{"h":4,"w":6,"x":6,"y":0},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"orange","value":0.7},{"color":"green","value":0.85}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"expr":"sum(rate(agent_requests_total{outcome=\"success\"}[5m]))/clamp_min(sum(rate(agent_requests_total[5m])),0.001)","legendFormat":"req success"}]},
    {"id":3,"type":"stat","title":"活跃任务","gridPos":{"h":4,"w":6,"x":12,"y":0},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":5},{"color":"red","value":10}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value"},"targets":[{"expr":"agent_active_tasks","legendFormat":"tasks"}]},
