    {"id":80,"type":"timeseries","title":"Goroutines","gridPos":{"h":8,"w":6,"x":0,"y":56},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"drawStyle":"line","fillOpacity":10}}},"options":{"legend":{"displayMode":"table","placement":"bottom"}},"targets":[{"expr":"go_goroutines","legendFormat":"goroutines"}]},
