    {"id":12,"type":"stat","title":"Token 输出 (tok/s)","gridPos":{"h":4,"w":6,"x":12,"y":4},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"ops","thresholds":{"mode":"absolute","steps":[{"color":"purple","value":null}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value"},"targets":[{"expr":"sum(rate(mewcode_llm_tokens_total{type=\"output\"}[5m]))","legendFormat":"output"}]},
    {"id":13,"type":"stat","title":"Cache 命中率","gridPos":{"h":4,"w":6,"x":18,"y":4},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"orange","value":0.3},{"color":"green","value":0.5}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"expr":"sum(rate(mewcode_llm_tokens_total{type=\"cache_read\"}[5m]))/clamp_min(sum(rate(mewcode_llm_tokens_total{type=~\"input|cache_read|cache_create\"}[5m])),0.001)","legendFormat":"cache"}]},
