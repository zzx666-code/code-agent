    {"id":10,"type":"stat","title":"Panic (1h)","gridPos":{"h":4,"w":6,"x":0,"y":4},"datasource":{"type":"prometheus","uid":"Prometheus"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"expr":"sum(increase(mewcode_panics_total[1h]))","legendFormat":"panics"}]},
